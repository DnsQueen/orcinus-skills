# CI dependencies for orcinus-skills (test, clean-install, and
# postgres-migration jobs). Pinned versions only — the compiled
# requirements-ci.txt carries a sha256 for every artifact, and CI
# installs with `pip install --require-hashes -r requirements-ci.txt`.
# Regenerate after any change here:
#   pip-compile --generate-hashes requirements-ci.in -o requirements-ci.txt
pytest==8.4.2
ruff==0.17.4
pyyaml==6.0.1
mypy==1.18.2
psycopg[binary]==3.3.8
# tomli is mypy's dependency on Python < 3.11 only (3.11+ uses
# stdlib tomllib), so a plain `pip-compile` on 3.12 omits it — and
# then the 3.10 CI job resolves it unpinned, which
# --require-hashes rejects (run 42298838900). Pin it explicitly
# so every supported Python installs from hashes.
tomli==2.5.0
# exceptiongroup is pytest's dependency on Python < 3.11 only —
# the same omission, the same failure: the 3.10 job in run
# 42300115306 hit it right after tomli was pinned.
exceptiongroup==1.3.1
