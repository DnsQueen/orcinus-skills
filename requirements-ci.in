# CI dependencies for orcinus-skills (test, clean-install, and
# postgres-migration jobs). Pinned versions only — the compiled
# requirements-ci.txt carries a sha256 for every artifact, and CI
# installs with `pip install --require-hashes -r requirements-ci.txt`.
# Regenerate after any change here:
#   pip-compile --generate-hashes requirements-ci.in -o requirements-ci.txt
pytest==8.4.2
ruff==0.17.4
pyyaml==6.0.1
mypy==1.18.2
psycopg[binary]==3.3.8
# tzdata is psycopg[binary]'s dependency on Windows only
# (sys_platform == "win32"), so a plain `pip-compile` on Linux
# omits it — and then the Windows CI job resolves it unpinned,
# which --require-hashes rejects (run 42384742442). Pin it
# explicitly so every supported platform installs from hashes.
tzdata==2026.6
# tomli and exceptiongroup were pinned here explicitly because they
# are conditional dependencies on Python < 3.11 only (tomli for
# mypy, exceptiongroup for pytest) and a plain `pip-compile` on
# 3.12 omits them — then the 3.10 CI job resolved them unpinned,
# which --require-hashes rejects (runs 42298838900, 42300115306).
# Both pins were removed 2026-11-07 (round 6, 2-S7) when Python
# 3.10 was dropped: no supported Python needs either shim now.
